@page "/"
@rendermode InteractiveServer

<PageTitle>Dashboard - AuthServer</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Dashboard</MudText>

<MudGrid Spacing="2">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 d-flex align-center gap-3" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Users</MudText>
                <MudText Typo="Typo.h5">
                    <MudLink Href="users" Color="Color.Primary">Manage</MudLink>
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 d-flex align-center gap-3" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Secondary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Clients</MudText>
                <MudText Typo="Typo.h5">
                    <MudLink Href="clients" Color="Color.Secondary">Manage</MudLink>
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 d-flex align-center gap-3" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Warning" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Signing Keys</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Auto-managed</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@page "/users"
@rendermode InteractiveServer

<PageTitle>Users - AuthServer</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudSelect T="ResourceServer" Label="Resource Server" Value="selectedResourceServer"
               ValueChanged="OnResourceServerChangedAsync"
               Variant="Variant.Outlined" Margin="Margin.Dense" Class="users-resource-server-select"
               ToStringFunc="@(rs => rs?.Name ?? string.Empty)">
        @foreach (var rs in resourceServers)
        {
            <MudSelectItem T="ResourceServer" Value="rs">@rs.Name</MudSelectItem>
        }
    </MudSelect>
    <MudTextField @bind-Value="searchText" Placeholder="Search..." Immediate="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="users-search-field"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" />
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="ShowAddDialogAsync">Add User</MudButton>
</MudStack>

<MudTable Items="FilteredUsers" Dense="true" Hover="true" Elevation="1" Loading="isLoading" T="User">
    <HeaderContent>
        <MudTh Class="col-icon"></MudTh>
        <MudTh>Username</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Email</MudTh>
        <MudTh Class="col-active">Active</MudTh>
        <MudTh Class="col-datetime">Created</MudTh>
        <MudTh Class="col-actions"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudIcon Icon="@Icons.Material.Filled.Person"
                     Color="@(context.IsActive ? Color.Primary : Color.Default)"
                     Size="Size.Small" />
        </MudTd>
        <MudTd DataLabel="Username">
            <MudText Class="text-monospace">@context.Username</MudText>
        </MudTd>
        <MudTd DataLabel="Name">@(context.Name ?? "-")</MudTd>
        <MudTd DataLabel="Email">@(context.Email ?? "-")</MudTd>
        <MudTd DataLabel="Active">
            @if (context.IsActive)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" Size="Size.Small" />
            }
        </MudTd>
        <MudTd DataLabel="Created">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
        </MudTd>
        <MudTd Class="table-actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => ShowEditDialogAsync(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" OnClick="() => ShowPasswordDialogAsync(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 mud-text-secondary">
            @(selectedResourceServer is null ? "Select a resource server." : "No users found.")
        </MudText>
    </NoRecordsContent>
</MudTable>

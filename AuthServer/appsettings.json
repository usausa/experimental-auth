{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Issuer": "http://localhost:5080",
    "AccessTokenLifetimeSeconds": 3600,
    "IdTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeSeconds": 86400,
    "JwksCacheMaxAgeSeconds": 3600,
    "SigningKeyRotationDays": 0,
    "SigningKeyGraceDays": 7,
    "MaintenanceIntervalMinutes": 60
  }
}

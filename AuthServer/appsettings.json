{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Issuer": "http://localhost:5080",
    "AccessTokenLifetimeSeconds": 900,
    "IdTokenLifetimeSeconds": 900,
    "RefreshTokenLifetimeSeconds": 604800,
    "RefreshTokenAbsoluteLifetimeSeconds": 2592000,
    "AuthorizationCodeLifetimeSeconds": 120,
    "DeviceCodeLifetimeSeconds": 600,
    "DeviceCodePollIntervalSeconds": 5,
    "JwksCacheMaxAgeSeconds": 3600,
    "SigningKeyAlgorithm": "RS256",
    "SigningKeyRotationDays": 0,
    "SigningKeyPrePublishSeconds": 3600,
    "SigningKeyGraceDays": 7,
    "MaintenanceIntervalMinutes": 60
  }
}
